# ---------------------------------------------------------------------------
# StudyBuddy frontend environment
# Copy to `.env.local` (git-ignored) and adjust for your machine.
#
# Every value here is compiled into the browser bundle and is publicly readable.
# Never put secrets (including the admin API key or a Gemini key) in this file.
# ---------------------------------------------------------------------------

# Hosted StudyBuddy API. Used for the production build and for Google sign-in.
VITE_API_ORIGIN=https://krushnas2.studybuddy.blitz.cloud

# ASP.NET Core API root. Leave unset in development: Vite proxies /api to
# VITE_API_ORIGIN (see vite.config.ts). For a static production deploy you can
# set this to /api and configure your host to proxy it, which avoids CORS.
# VITE_API_BASE_URL=https://krushnas2.studybuddy.blitz.cloud/api

# FastAPI AI service root (only used by the optional Notes generator).
# VITE_AI_BASE_URL=/ai

# Google OAuth start URL. Opened in a popup; must reach the hosted API.
# VITE_GOOGLE_AUTH_URL=https://krushnas2.studybuddy.blitz.cloud/api/login-google

# NOTE on CORS: the hosted API currently returns no Access-Control-Allow-Origin
# header, so direct cross-origin calls from a static deploy are blocked by the
# browser. Either deploy behind a same-origin /api proxy (recommended) or enable
# CORS on the API for your frontend origin — with Access-Control-Allow-Credentials
# for /api/auth/google-response, which the Google flow needs.
