# ---------------------------------------------------------------------------
# StudyBuddy frontend environment
# Copy to `.env.local` (git-ignored) and adjust for your machine.
#
# Both values are BASE URLs only. No secrets belong in this file — everything
# here is compiled into the browser bundle and is publicly readable.
# ---------------------------------------------------------------------------

# ASP.NET Core API root. Default routes through the Vite dev proxy, which
# forwards to https://localhost:7000 (see vite.config.ts).
VITE_API_BASE_URL=/api

# FastAPI AI service root. Default routes through the Vite dev proxy, which
# forwards to http://127.0.0.1:8000 and strips the /ai prefix.
# FastAPI registers no CORSMiddleware, so calling http://localhost:8000
# directly from the browser will be blocked — keep the proxy for dev.
VITE_AI_BASE_URL=/ai

# Google OAuth start URL. The .NET endpoint challenges Google and must be a
# top-level navigation, not an XHR.
VITE_GOOGLE_AUTH_URL=/api/login-google
